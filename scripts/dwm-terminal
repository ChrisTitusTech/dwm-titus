#!/usr/bin/env bash
set -euo pipefail

DEFAULT_TERMINALS=(
	dwmterm
	alacritty
	kitty
	st
	warp-terminal
	xterm
)

print_only=0
if [[ ${1:-} == "--print-command" ]]; then
	print_only=1
	shift
fi
update_center=0
update_center_title='dwm update center'
if [[ ${1:-} == "--update-center" ]]; then
	update_center=1
	shift
	(($# > 0)) || {
		printf '%s\n' 'dwm-terminal: --update-center requires a command.' >&2
		exit 2
	}
	# Read the guarded preference once, before the window is mapped. Keep the
	# same mode in the child so its OSC title cannot undo the matching rule.
	settings_output=$(/usr/bin/python3 "${BASH_SOURCE[0]%/*}/dwm-update-center-settings" status 2>/dev/null) || settings_output=
	export DWM_UPDATE_CENTER_WINDOW_MODE=tiled
	if [[ $settings_output == *$'\npreference\twindowMode\tfloating\n'* ]]; then
		export DWM_UPDATE_CENTER_WINDOW_MODE=floating
	else
		update_center_title='dwm update center tiled'
	fi
fi

find_herdr() {
	local candidate

	case ${DWM_HERDR:-0} in
	1 | true | yes) ;;
	*) return 1 ;;
	esac

	if [[ -n ${DWM_HERDR_COMMAND:-} ]]; then
		if command -v "$DWM_HERDR_COMMAND" >/dev/null 2>&1; then
			command -v "$DWM_HERDR_COMMAND"
			return
		fi
		if [[ -x $DWM_HERDR_COMMAND ]]; then
			printf '%s\n' "$DWM_HERDR_COMMAND"
			return
		fi
		return 1
	fi

	if candidate=$(command -v herdr 2>/dev/null); then
		printf '%s\n' "$candidate"
		return
	fi

	candidate="${HOME:-}/.local/bin/herdr"
	if [[ -n ${HOME:-} && -x $candidate ]]; then
		printf '%s\n' "$candidate"
		return
	fi

	return 1
}

configured_terminal() {
	local config_home=${XDG_CONFIG_HOME:-${HOME:-}/.config}
	local config=$config_home/dwm-titus/hotkeys.toml
	local line value=
	local count=0
	local in_vars=0

	[[ -f $config && ! -L $config ]] || return 1
	while IFS= read -r line || [[ -n $line ]]; do
		case $line in
		'[vars]')
			in_vars=1
			continue
			;;
		'['*) in_vars=0 ;;
		esac
		[[ $in_vars -eq 1 ]] || continue
		if [[ $line =~ ^[[:space:]]*terminal[[:space:]]*=[[:space:]]*\"([^\"]+)\"[[:space:]]*$ ]]; then
			value=${BASH_REMATCH[1]}
			count=$((count + 1))
		elif [[ $line =~ ^[[:space:]]*terminal[[:space:]]*= ]]; then
			return 1
		fi
	done <"$config"
	[[ $count -eq 1 ]] || return 1
	[[ $value =~ ^[A-Za-z0-9._+-]+$ ]] || return 1
	printf '%s\n' "$value"
}

terminals=()

if [[ ${DWM_TERMINAL:-} != "" ]]; then
	terminals+=("$DWM_TERMINAL")
fi

if terminal=$(configured_terminal 2>/dev/null); then
	terminals+=("$terminal")
fi

terminals+=("${DEFAULT_TERMINALS[@]}")

launch_update_center_terminal() {
	local candidate=$1
	shift

	case ${candidate##*/} in
	alacritty)
		DWM_UPDATE_CENTER_TERMINAL_IDENTITY=1 exec "$candidate" \
			--class DwmUpdateCenter,dwm-update-center --title "$update_center_title" \
			-o font.size=9 -e "$@"
		;;
	kitty)
		DWM_UPDATE_CENTER_TERMINAL_IDENTITY=1 exec "$candidate" \
			--class DwmUpdateCenter --name dwm-update-center --title "$update_center_title" \
			-o font_size=9 "$@"
		;;
	dwmterm)
		DWM_UPDATE_CENTER_TERMINAL_IDENTITY=1 exec "$candidate" \
			-n dwm-update-center -c DwmUpdateCenter -t "$update_center_title" \
			-s 9 -e "$@"
		;;
	st)
		DWM_UPDATE_CENTER_TERMINAL_IDENTITY=1 exec "$candidate" \
			-n dwm-update-center -c DwmUpdateCenter -t "$update_center_title" \
			-f 'monospace:size=9' -e "$@"
		;;
	xterm)
		DWM_UPDATE_CENTER_TERMINAL_IDENTITY=1 exec "$candidate" \
			-name dwm-update-center -class DwmUpdateCenter -title "$update_center_title" \
			-fs 9 -e "$@"
		;;
	*)
		return 1
		;;
	esac
}

if ((update_center)); then
	if [[ -n ${DWM_UPDATE_CENTER_TERMINAL:-} ]]; then
		if command -v "$DWM_UPDATE_CENTER_TERMINAL" >/dev/null 2>&1; then
			if ((print_only)); then
				printf '%s\n' "$DWM_UPDATE_CENTER_TERMINAL"
				exit 0
			fi
			launch_update_center_terminal "$DWM_UPDATE_CENTER_TERMINAL" "$@" ||
				DWM_UPDATE_CENTER_TERMINAL_IDENTITY=1 exec "$DWM_UPDATE_CENTER_TERMINAL" -e "$@" 2>/dev/null ||
				DWM_UPDATE_CENTER_TERMINAL_IDENTITY=1 exec "$DWM_UPDATE_CENTER_TERMINAL" "$@"
		fi
	fi

	update_center_candidates=()
	if [[ -n ${DWM_TERMINAL:-} ]]; then
		update_center_candidates+=("$DWM_TERMINAL")
	fi
	if terminal=$(configured_terminal 2>/dev/null); then
		update_center_candidates+=("$terminal")
	fi
	update_center_candidates+=(alacritty kitty dwmterm st xterm)

	for candidate in "${update_center_candidates[@]}"; do
		if command -v "$candidate" >/dev/null 2>&1; then
			if ((print_only)); then
				printf '%s\n' "$candidate"
				exit 0
			fi
			launch_update_center_terminal "$candidate" "$@" || continue
		fi
	done

	printf '%s\n' 'dwm-terminal: no supported terminal emulator for update center found.' >&2
	exit 127
fi

for terminal in "${terminals[@]}"; do
	if command -v "$terminal" >/dev/null 2>&1; then
		if ((print_only)); then
			printf '%s\n' "$terminal"
			exit 0
		fi

		if (($# == 0)) && herdr=$(find_herdr); then
			exec "$terminal" -e "$herdr"
		fi

		exec "$terminal" "$@"
	fi
done

printf '%s\n' \
	'dwm-terminal: no supported terminal emulator found.' \
	'' \
	'Install one of: dwmterm, alacritty, kitty, st, warp-terminal, xterm.' \
	'Or set DWM_TERMINAL to an installed terminal command.' >&2

exit 127
