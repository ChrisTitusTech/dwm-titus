#!/bin/sh
set -eu

print_default_names() {
	count=${1:-9}
	i=1
	sep=
	while [ "$i" -le "$count" ]; do
		printf '%s%s' "$sep" "$i"
		sep='|'
		i=$((i + 1))
	done
}

clean_line() {
	tr '\r\n' '  ' | sed 's/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//'
}

root_property_value() {
	prop=$1
	# xprop prints WINDOW lists as "NAME(WINDOW): window id # 0x1, 0x2".
	xprop -root "$prop" 2>/dev/null |
		sed -n -e 's/^[^=]*= //p' -e 's/^[^:]*: window id # //p'
}

root_status() {
	xprop -root WM_NAME 2>/dev/null |
		awk -F'= ' '
			/^WM_NAME/ {
				status = $2
				gsub(/^"/, "", status)
				gsub(/"$/, "", status)
				print status
				found = 1
				exit
			}
			END {
				if (!found) {
					print ""
				}
			}
		' | clean_line
}

# Joins the strings of an xprop string list ("a, b", "c") with "|". Commas and
# escaped quotes inside a string stay part of it. keep_empty=1 keeps empty
# strings so positions still match (keyboard groups).
quoted_list() {
	awk -v keep_empty="${1:-0}" '
		{
			out = ""; sep = ""; cur = ""; inq = 0; n = length($0)
			for (i = 1; i <= n; i++) {
				ch = substr($0, i, 1)
				if (!inq) {
					if (ch == "\"") { inq = 1; cur = "" }
					continue
				}
				if (ch == "\\" && i < n) {
					i++
					cur = cur substr($0, i, 1)
				} else if (ch == "\"") {
					inq = 0
					if (cur != "" || keep_empty) { out = out sep cur; sep = "|" }
				} else {
					cur = cur ch
				}
			}
			print out
			exit
		}
	'
}

desktop_names() {
	names=$(root_property_value _NET_DESKTOP_NAMES | quoted_list 1)
	if [ -n "$names" ]; then
		printf '%s' "$names"
	else
		print_default_names "$1"
	fi
}

# Classify symbol components using the installed layout catalogue, not their
# position among model/option includes. localectl exposes the machine list;
# the rules data is a fallback when that optional frontend is unavailable.
keyboard_catalog_loaded=0
keyboard_layout_catalog=
load_keyboard_layout_catalog() {
	[ "$keyboard_catalog_loaded" -eq 0 ] || return 0
	keyboard_catalog_loaded=1
	catalog=
	if command -v localectl >/dev/null 2>&1; then
		catalog=$(timeout 2 localectl list-x11-keymap-layouts 2>/dev/null || true)
	fi
	if [ -z "$catalog" ]; then
		for rules in /usr/share/X11/xkb/rules/evdev.lst /usr/share/X11/xkb/rules/base.lst; do
			[ -r "$rules" ] || continue
			catalog=$(awk '$1 == "!" { section = $2; next } section == "layout" { print $1 }' "$rules")
			[ -z "$catalog" ] || break
		done
	fi
	keyboard_layout_catalog=$(printf '%s\n' "$catalog" | awk '/^[A-Za-z0-9_-]+$/ { print }' | paste -sd '|' -)
}

# _DWM_KEYBOARD_SYMBOLS describes the loaded map. The rules-names hint is used
# only if symbols are absent, since xkbcomp can leave rules names stale.
keyboard_codes() {
	symbols=$1
	hint=$2
	groups=$3
	catalog=${4:-}
	awk -v symbols="$symbols" -v hint="$hint" -v groups="$groups" -v catalog="$catalog" '
		function base(token) {
			sub(/^.*\//, "", token)
			sub(/:[1-4]$/, "", token)
			sub(/\(.*$/, "", token)
			return token
		}
		BEGIN {
			if (groups !~ /^[1-4]$/) exit
			split(catalog, layouts, "|")
			for (i in layouts) known[layouts[i]] = 1
			if (symbols != "") {
				n = split(symbols, tokens, "+")
				for (i = 1; i <= n; i++) {
					token = tokens[i]
					code = base(token)
					if (!(code in known)) continue
					if (match(token, /:[1-4]$/)) {
						group = substr(token, RSTART + 1) + 0
						if (codes[group] == "") codes[group] = code
					} else if (implicit == "") {
						implicit = code
					}
				}
				if (codes[1] == "") codes[1] = implicit
			} else if (hint != "") {
				split(hint, layouts, ",")
				for (i = 1; i <= groups; i++) codes[i] = base(layouts[i])
			}
			for (i = 1; i <= groups; i++) {
				code = codes[i]
				if (code !~ /^[A-Za-z0-9_-]+$/) code = ""
				printf "%s%s", (i > 1 ? "|" : ""), code
			}
		}
	'
}

# One xprop read for all keyboard fields. dwm publishes _DWM_KEYBOARD_GROUP as
# "effective group, group count"; a missing property means no XKB data.
keyboard_state() {
	load_keyboard_layout_catalog
	props=$(xprop -root _DWM_KEYBOARD_GROUP _DWM_KEYBOARD_GROUP_NAMES \
		_DWM_KEYBOARD_SYMBOLS _XKB_RULES_NAMES 2>/dev/null || true)
	pair=$(printf '%s\n' "$props" | sed -n 's/^_DWM_KEYBOARD_GROUP(CARDINAL) = //p')
	group=${pair%%,*}
	groups=${pair#*, }
	case "$group:$groups" in
	[0-3]:[1-4]) ;;
	*)
		group=0
		groups=0
		;;
	esac
	names=$(printf '%s\n' "$props" | sed -n 's/^_DWM_KEYBOARD_GROUP_NAMES([^)]*) = //p' | quoted_list 1)
	symbols=$(printf '%s\n' "$props" | sed -n 's/^_DWM_KEYBOARD_SYMBOLS([^)]*) = //p' | quoted_list)
	hint=$(printf '%s\n' "$props" | sed -n 's/^_XKB_RULES_NAMES([^)]*) = //p' | quoted_list 1 |
		awk -F'|' '{ print $3 }')
	printf 'keyboard_group=%s\n' "$group"
	printf 'keyboard_groups=%s\n' "$groups"
	printf 'keyboard_names=%s\n' "$names"
	printf 'keyboard_layouts=%s\n' "$(keyboard_codes "$symbols" "$hint" "$groups" "$keyboard_layout_catalog")"
}

# A group switch only changes _DWM_KEYBOARD_GROUP, and its value is already in
# the spy line, so print just the two numbers without reading anything else.
keyboard_group_event() {
	case $1 in
	*'= '*)
		pair=${1#*= }
		group=${pair%%,*}
		groups=${pair#*, }
		;;
	*)
		group=
		groups=
		;;
	esac
	case "$group:$groups" in
	[0-3]:[1-4]) ;;
	*)
		group=0
		groups=0
		;;
	esac
	printf 'keyboard_group=%s\n' "$group"
	printf 'keyboard_groups=%s\n' "$groups"
}

active_window_id() {
	xdotool getactivewindow 2>/dev/null || {
		root_property_value _NET_ACTIVE_WINDOW |
			awk '$1 != "0x0" { print $1; exit }'
	}
}

# One xprop per client: "id<TAB>desktop<TAB>pid<TAB>class", empty fields as "-".
client_rows() {
	root_property_value _NET_CLIENT_LIST |
		tr ',' '\n' |
		awk 'NF { print $NF }' |
		while IFS= read -r window_id; do
			xprop -id "$window_id" _NET_WM_DESKTOP _NET_WM_PID WM_CLASS 2>/dev/null |
				awk -F'= ' -v id="$window_id" '
					/^_NET_WM_DESKTOP/ && $2 ~ /^[0-9]+$/ { desktop = $2 }
					/^_NET_WM_PID/ && $2 ~ /^[0-9]+$/ { pid = $2 }
					/^WM_CLASS/ {
						gsub(/"/, "", $2)
						split($2, classes, /, /)
						class = tolower(classes[2])
					}
					END {
						printf "%s\t%s\t%s\t%s\n", id, desktop == "" ? "-" : desktop,
							pid == "" ? "-" : pid, class == "" ? "-" : class
					}'
		done
}

occupied_workspaces() {
	printf '%s\n' "$1" |
		awk -F'\t' '$2 ~ /^[0-9]+$/ && $2 != 4294967295 { print $2 }' |
		sort -nu |
		paste -sd '|' -
}

fullscreen_monitors() {
	root_property_value _DWM_FULLSCREEN_MONITORS |
		tr ',' '\n' |
		awk '$1 ~ /^[0-9]+$/ { print $1 }' |
		sort -nu |
		paste -sd '|' -
}

running_apps() {
	pids=$(printf '%s\n' "$1" | awk -F'\t' '$3 ~ /^[0-9]+$/ { print $3 }' | paste -sd, -)
	root_pids=
	if [ -n "$pids" ]; then
		root_pids=$(ps -o uid=,pid= -p "$pids" 2>/dev/null | awk '$1 == 0 { print $2 }' | paste -sd, -)
	fi
	printf '%s\n' "$1" |
		awk -F'\t' -v root_pids=",$root_pids," '
			NF < 4 || $4 == "-" || $2 !~ /^[0-9]+$/ { next }
			$3 != "-" && index(root_pids, "," $3 ",") { next }
			seen[$4]++ { next }
			{ print $1 ":" $4 }' |
		paste -sd '|' -
}

window_title() {
	window_id=$1
	[ -n "$window_id" ] || return 1
	xprop -id "$window_id" _NET_WM_NAME WM_NAME 2>/dev/null |
		awk -F'= ' '
			/^_NET_WM_NAME/ {
				title = $2
				gsub(/^"/, "", title)
				gsub(/"$/, "", title)
				print title
				found = 1
				exit
			}
			/^WM_NAME/ {
				title = $2
				gsub(/^"/, "", title)
				gsub(/"$/, "", title)
				fallback = title
			}
			END {
				if (!found && fallback != "") {
					print fallback
				}
			}
		' | clean_line
}

window_class() {
	window_id=$1
	[ -n "$window_id" ] || return 1
	xprop -id "$window_id" WM_CLASS 2>/dev/null |
		awk -F'= ' '/^WM_CLASS/ { gsub(/"/, "", $2); split($2, classes, /, /); print tolower(classes[2]); exit }'
}

show_state() {
	current=$(root_property_value _NET_CURRENT_DESKTOP | awk '{ print $1; exit }')
	count=$(root_property_value _NET_NUMBER_OF_DESKTOPS | awk '{ print $1; exit }')
	current=${current:-0}
	count=${count:-9}
	names=$(desktop_names "$count")
	window_id=$(active_window_id)
	title=$(window_title "$window_id" || true)
	title=${title:-Desktop}
	class=$(window_class "$window_id" || true)
	class=${class:-application-x-executable}
	status=$(root_status)
	clients=$(client_rows)
	occupied=$(occupied_workspaces "$clients")
	fullscreen_monitors=$(fullscreen_monitors)
	apps=$(running_apps "$clients")
	monitor_desktops=$(
		root_property_value _DWM_MONITOR_DESKTOPS |
			tr -d '[:space:]'
	)
	monitor_desktops=${monitor_desktops:-$current}
	focused_monitor=$(root_property_value _DWM_SELECTED_MONITOR | awk '{ print $1; exit }')

	printf 'current=%s\n' "$current"
	printf 'monitor_desktops=%s\n' "$monitor_desktops"
	printf 'focused_monitor=%s\n' "$focused_monitor"
	printf 'count=%s\n' "$count"
	printf 'names=%s\n' "$names"
	printf 'occupied=%s\n' "$occupied"
	printf 'fullscreen_monitors=%s\n' "$fullscreen_monitors"
	printf 'apps=%s\n' "$apps"
	printf 'active_window=%s\n' "$window_id"
	printf 'title=%s\n' "$title"
	printf 'class=%s\n' "$class"
	printf 'status=%s\n' "$status"
	keyboard_state
}

watch_state() {
	show_state
	printf '\n'

	if xprop -root _DWM_MONITOR_DESKTOPS >/dev/null 2>&1; then
		xprop -root -spy \
			DWM_TAG_UPDATE \
			_DWM_MONITOR_DESKTOPS \
			_DWM_SELECTED_MONITOR \
			_NET_NUMBER_OF_DESKTOPS \
			_NET_DESKTOP_NAMES \
			_NET_ACTIVE_WINDOW \
			_NET_CLIENT_LIST \
			_DWM_FULLSCREEN_MONITORS \
			_DWM_KEYBOARD_GROUP \
			_DWM_KEYBOARD_GROUP_NAMES \
			_DWM_KEYBOARD_SYMBOLS \
			_XKB_RULES_NAMES \
			WM_NAME 2>/dev/null
	else
		xprop -root -spy \
			DWM_TAG_UPDATE \
			_NET_CURRENT_DESKTOP \
			_NET_NUMBER_OF_DESKTOPS \
			_NET_DESKTOP_NAMES \
			_NET_ACTIVE_WINDOW \
			_NET_CLIENT_LIST \
			_DWM_FULLSCREEN_MONITORS \
			_DWM_KEYBOARD_GROUP \
			_DWM_KEYBOARD_GROUP_NAMES \
			_DWM_KEYBOARD_SYMBOLS \
			_XKB_RULES_NAMES \
			WM_NAME 2>/dev/null
	fi |
		while IFS= read -r _event; do
			# Keyboard lines get a partial block (only keyboard_* keys); the
			# panel keeps every other value from the previous block.
			case $_event in
			_DWM_KEYBOARD_GROUP\(* | _DWM_KEYBOARD_GROUP:*)
				keyboard_group_event "$_event"
				;;
			# _XKB_RULES_NAMES is the layout fallback without the symbols name
			_DWM_KEYBOARD_GROUP_NAMES* | _DWM_KEYBOARD_SYMBOLS* | _XKB_RULES_NAMES*)
				keyboard_state
				;;
			*)
				show_state
				;;
			esac
			printf '\n'
		done
}

request_keyboard_group() {
	target=${1:-}
	case $target in
	next | prev | [0-3]) ;;
	*)
		printf 'usage: %s keyboard-group <next|prev|0-3>\n' "$0" >&2
		return 2
		;;
	esac
	xprop -root -f _DWM_KEYBOARD_GROUP_REQUEST 8s \
		-set _DWM_KEYBOARD_GROUP_REQUEST "$target" || return 1
	# dwm deletes the property when it takes the request. Wait for that
	# (up to about a second) so a caller that sends one request after the
	# other never overwrites one dwm has not read yet. Usually it is gone by
	# the first look; otherwise one xprop -spy waits for the delete.
	xprop -root _DWM_KEYBOARD_GROUP_REQUEST 2>/dev/null | grep -q ' = ' || return 0
	spy_dir=$(mktemp -d) || return 1
	spy_pid=
	cleanup_keyboard_spy() {
		if [ -n "$spy_pid" ]; then
			kill "$spy_pid" 2>/dev/null || true
			wait "$spy_pid" 2>/dev/null || true
		fi
		rm -rf "$spy_dir"
	}
	# Arm cleanup before FIFO creation: failures and signals must not leak it.
	trap cleanup_keyboard_spy EXIT
	trap 'exit 143' HUP INT TERM
	mkfifo "$spy_dir/spy" || {
		rm -rf "$spy_dir"
		return 1
	}
	# -spy prints the current value first, so a delete before it started
	# is seen too
	timeout 1 xprop -root -spy _DWM_KEYBOARD_GROUP_REQUEST >"$spy_dir/spy" 2>/dev/null &
	spy_pid=$!
	taken=1
	while IFS= read -r spy_line; do
		case $spy_line in
		*'not found'*)
			taken=0
			break
			;;
		esac
	done <"$spy_dir/spy"
	cleanup_keyboard_spy
	trap - EXIT HUP INT TERM
	# xprop prints the value before it listens, so a delete in between
	# sends no event: look once more before giving up
	if [ "$taken" -ne 0 ] &&
		xprop -root _DWM_KEYBOARD_GROUP_REQUEST 2>/dev/null | grep -q ' = '; then
		printf 'dwm did not take the keyboard layout request; is dwm running?\n' >&2
		return 75
	fi
}

switch_workspace() {
	target=${1:-}
	case $target in
	'' | *[!0-9]*)
		printf 'usage: %s switch <zero-based-workspace>\n' "$0" >&2
		return 2
		;;
	esac
	command -v wmctrl >/dev/null 2>&1 || {
		printf 'wmctrl is required for workspace switching\n' >&2
		return 127
	}
	wmctrl -s "$target"
}

focus_window() {
	target=${1:-}
	case $target in
	0x[0-9a-fA-F]* | [0-9]*) ;;
	*)
		printf 'usage: %s focus <window-id>\n' "$0" >&2
		return 2
		;;
	esac
	wmctrl -ia "$target"
}

case ${1:-state} in
state)
	show_state
	;;
watch)
	watch_state
	;;
switch)
	switch_workspace "${2:-}"
	;;
focus)
	focus_window "${2:-}"
	;;
keyboard-group)
	request_keyboard_group "${2:-}"
	;;
*)
	printf 'usage: %s [state|watch|switch <zero-based-workspace>|focus <window-id>|keyboard-group <next|prev|0-3>]\n' "$0" >&2
	exit 2
	;;
esac
