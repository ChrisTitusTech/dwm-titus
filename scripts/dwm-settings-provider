#!/bin/sh
set -eu

script_dir=$(
	unset CDPATH
	cd -- "$(dirname -- "$0")" && pwd
)
usage() {
	printf 'usage: %s discover\n' "$0" >&2
}

clean_field() {
	printf '%s' "$1" | tr '\011\015\012' '   '
}

os_value() {
	key=$1
	file=$2
	awk -F= -v key="$key" '
		$1 == key {
			value = substr($0, index($0, "=") + 1)
			gsub(/^"|"$/, "", value)
			print value
			exit
		}
	' "$file" 2>/dev/null || true
}

platform_family() {
	id=$1

	case "$id" in
	fedora) printf '%s\n' fedora ;;
	*) printf '%s\n' unknown ;;
	esac
}

provider_path() {
	command_name=$1
	if command -v "$command_name" >/dev/null 2>&1; then
		command -v "$command_name"
	elif [ -x "$script_dir/$command_name" ]; then
		printf '%s\n' "$script_dir/$command_name"
	else
		return 1
	fi
}

provider_available() {
	provider_path "$1" >/dev/null 2>&1
}

# Keep discovery responsive even when a service client cannot reach its daemon.
run_bounded_probe() {
	command_name=$1
	shift
	command_path=$(provider_path "$command_name") || return 1
	timeout_path=$(command -v timeout 2>/dev/null) || return 1
	"$timeout_path" --signal=TERM --kill-after=1 2 \
		"$command_path" "$@" >/dev/null 2>&1
}

input_snapshot_valid() {
	command_path=$(provider_path dwm-settings-input) || return 1
	timeout_path=$(command -v timeout 2>/dev/null) || return 1
	input_snapshot=$("$timeout_path" --signal=TERM --kill-after=1 2 \
		"$command_path" discover 2>/dev/null) || return 1
	printf '%s\n' "$input_snapshot" |
		awk -F '\t' '
			NR == 1 && $0 == "input-protocol\t1" {
				header = 1
				protocols++
				next
			}
			$1 == "input-protocol" { protocols++; invalid = 1; next }
			$1 == "device" && NF == 5 && $2 != "" && $3 != "" && $4 != "" && $5 != "" { next }
			$1 == "device" { invalid = 1; next }
			$1 == "setting" && NF == 9 && $2 != "" && $3 != "" && $4 != "" && $5 != "" { next }
			$1 == "setting" { invalid = 1; next }
			$1 == "unsupported" && NF == 4 && $2 != "" && $3 != "" && $4 != "" { next }
			$1 == "unsupported" { invalid = 1; next }
			{ next }
			END { exit(header && protocols == 1 && !invalid ? 0 : 1) }
		'
}

appearance_snapshot_valid() {
	command_path=$(provider_path dwm-settings-appearance) || return 1
	timeout_path=$(command -v timeout 2>/dev/null) || return 1
	appearance_snapshot=$("$timeout_path" 5 "$command_path" snapshot 2>/dev/null) || return 1
	printf '%s\n' "$appearance_snapshot" |
		awk -F '\t' '
			NR == 1 { header = ($0 == "appearance-protocol\t1\t0"); next }
			$1 == "provider" && $2 == "appearance" &&
				($3 == "available" || $3 == "partial") && $4 == "read-only" { provider = 1 }
			$1 == "source" && ($2 == "user" || $2 == "managed") && $3 != "" { source = 1 }
			$1 == "active" && $2 != "" && $3 != "" &&
				($4 == "selected" || $4 == "recovery") { active = 1 }
			$1 == "theme" && NF >= 7 { theme = 1 }
			END { exit(header && provider && source && active && theme ? 0 : 1) }
		'
}

appearance_mutation_ready() {
	command_path=$(provider_path dwm-settings-theme) || return 1
	timeout_path=$(command -v timeout 2>/dev/null) || return 1
	if [ "$command_path" = "$script_dir/dwm-settings-theme" ] &&
		[ -f "$script_dir/../config/themes.toml" ]; then
		DWM_APPEARANCE_MANAGED_THEMES_FILE=$script_dir/../config/themes.toml \
			"$timeout_path" 2 "$command_path" mutation-ready >/dev/null 2>&1
	else
		"$timeout_path" 2 "$command_path" mutation-ready >/dev/null 2>&1
	fi
}

emit_text_scale_capability() {
	command_path=$(provider_path dwm-settings-personalization 2>/dev/null || true)
	if [ -z "$command_path" ]; then
		emit_capability appearance accessibility-text-scale 'Text scaling' unavailable user-session \
			dwm-settings-personalization 'Install the managed personalization provider'
		return
	fi

	timeout_path=$(command -v timeout 2>/dev/null || true)
	if [ -z "$timeout_path" ] ||
		! personalization_snapshot=$("$timeout_path" --signal=TERM --kill-after=1 \
			5 "$command_path" status 2>/dev/null); then
		emit_capability appearance accessibility-text-scale 'Text scaling' unavailable user-session \
			dwm-settings-personalization 'The personalization provider is not responding'
		return
	fi

	text_scale_record=$(printf '%s\n' "$personalization_snapshot" |
		awk -F '\t' '
			function valid_state(value) {
				return value == "available" || value == "partial" ||
					value == "restricted" || value == "unavailable"
			}
			function valid_ready_state(value) {
				return value == "available" || value == "restricted" || value == "unavailable"
			}
			function valid_capability(value) {
				return value == "font" || value == "text-size" || value == "cursor" ||
					value == "icon" || value == "gtk" || value == "qt"
			}
			function valid_option(capability, value) {
				if (value == "unknown") return 1
				if (capability == "text-size")
					return value == "follow-system" || value == "0.75" || value == "0.875" ||
						value == "1.0" || value == "1.125" || value == "1.25" || value == "1.5" ||
						value == "1.75" || value == "2.0"
				if (capability == "qt")
					return value == "follow-theme" || value == "gtk3" ||
						value == "qt6ct" || value == "qt5ct"
				return value != ""
			}
			$1 == "personalization-protocol" {
				protocols++
				if (NR == 1 && $0 == "personalization-protocol\t1\t0") header = 1
				next
			}
			$1 == "provider" {
				providers++
				if (NF != 5 || $2 != "personalization" || !valid_state($3) ||
					$4 != "user-session" || $5 == "" || providers != 1) invalid = 1
				next
			}
			$1 == "mutation" {
				mutations++
				if (NF != 3 || !valid_state($2) || $3 == "" || mutations != 1) invalid = 1
				next
			}
			$1 == "repair" {
				repairs++
				if (NF != 3 || !valid_ready_state($2) || $3 == "" || repairs != 1) invalid = 1
				next
			}
			$1 == "watch-readiness" {
				watches++
				if (NF != 4 || $2 != "text-size" ||
					($3 != "available" && $3 != "unavailable") || $4 == "" || watches != 1) invalid = 1
				next
			}
			$1 == "selection" && $2 == "text-size" {
				selections++
				selection_seen[$2]++
				if (NF == 6 &&
					($3 == "available" || $3 == "partial" || $3 == "unavailable") &&
					($3 == "unavailable" || $4 != "") &&
					valid_option($2, $5) && $6 != "" && selection_seen[$2] == 1) {
					state = $3
					detail = $6
					valid_selections++
				} else invalid = 1
				next
			}
			$1 == "selection" {
				selection_seen[$2]++
				if (NF != 6 || !valid_capability($2) || !valid_state($3) ||
					!valid_option($2, $5) || $6 == "" || selection_seen[$2] != 1) invalid = 1
				next
			}
			$1 == "action-readiness" {
				readiness_seen[$2]++
				if (NF != 5 || !valid_capability($2) || !valid_ready_state($3) ||
					!valid_ready_state($4) || $5 == "" || readiness_seen[$2] != 1) invalid = 1
				next
			}
			$1 == "delegate" {
				delegate_seen[$2]++
				if (NF != 5 || ($2 != "gtk" && $2 != "qt") ||
					($3 != "available" && $3 != "unavailable") ||
					($3 == "available" && $4 == "") || $5 == "" || delegate_seen[$2] != 1) invalid = 1
				next
			}
			$1 == "complete" && $2 == "status" && NF == 2 {
				complete_line = NR
				completions++
				next
			}
			$1 == "complete" { invalid = 1; next }
			# Version 1 is append-only: reject malformed known records, but ignore new record types.
			{ next }
			END {
				if (!invalid && header && protocols == 1 && selections == 1 &&
					valid_selections == 1 && providers == 1 && mutations == 1 &&
					repairs == 1 && watches == 1 &&
					selection_seen["font"] == 1 && selection_seen["text-size"] == 1 &&
					selection_seen["cursor"] == 1 && selection_seen["icon"] == 1 &&
					selection_seen["gtk"] == 1 && selection_seen["qt"] == 1 &&
					readiness_seen["font"] == 1 && readiness_seen["text-size"] == 1 &&
					readiness_seen["cursor"] == 1 && readiness_seen["icon"] == 1 &&
					readiness_seen["gtk"] == 1 && readiness_seen["qt"] == 1 &&
					delegate_seen["gtk"] == 1 && delegate_seen["qt"] == 1 && completions == 1 &&
					complete_line == NR && detail != "")
					printf "%s\t%s\n", state, detail
				else
					exit 1
			}
		' 2>/dev/null) || text_scale_record=
	if [ -z "$text_scale_record" ]; then
		emit_capability appearance accessibility-text-scale 'Text scaling' unavailable user-session \
			dwm-settings-personalization 'The personalization provider returned an unsupported response'
		return
	fi

	tab=$(printf '\t')
	text_scale_state=${text_scale_record%%"$tab"*}
	text_scale_detail=${text_scale_record#*"$tab"}
	emit_capability appearance accessibility-text-scale 'Text scaling' "$text_scale_state" user-session \
		dwm-settings-personalization "$text_scale_detail"
}

emit_accessibility_capabilities() {
	emit_text_scale_capability
	emit_capability appearance accessibility-contrast 'High contrast' partial read-only \
		quickshell-theme 'Semantic colors are available; a dedicated high-contrast policy is not configured'
	emit_capability appearance accessibility-reduced-motion 'Reduced motion' unsupported read-only \
		quickshell-theme 'Managed shell animations do not yet expose a reduced-motion policy'
	if run_bounded_probe busctl --user --quiet status org.freedesktop.Notifications; then
		emit_capability appearance accessibility-notifications 'Notification policy' partial read-only \
			dbus 'A notification D-Bus owner is active; managed policy controls are not configured'
	else
		emit_capability appearance accessibility-notifications 'Notification policy' unavailable read-only \
			dbus 'No notification D-Bus owner is observable in this session'
	fi
	if [ "$input_discovery_state" = available ]; then
		emit_capability appearance accessibility-input 'Keyboard and pointer access' partial read-only x11 \
			'Input discovery and settings are available; dedicated accessibility controls are not configured'
	elif [ "$input_discovery_state" = unready ]; then
		emit_capability appearance accessibility-input 'Keyboard and pointer access' unavailable read-only x11 \
			'Input tools are installed, but no responsive XInput session is available'
	else
		emit_capability appearance accessibility-input 'Keyboard and pointer access' unavailable read-only x11 \
			'Install xinput and the managed input Settings provider'
	fi
}

emit_capability() {
	section=$1
	id=$2
	label=$3
	status=$4
	class=$5
	provider=$6
	detail=$7

	printf 'capability\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
		"$(clean_field "$section")" \
		"$(clean_field "$id")" \
		"$(clean_field "$label")" \
		"$(clean_field "$status")" \
		"$(clean_field "$class")" \
		"$(clean_field "$provider")" \
		"$(clean_field "$detail")"
}

emit_probed_command_capability() {
	section=$1
	id=$2
	label=$3
	class=$4
	command_name=$5
	available_detail=$6
	missing_detail=$7
	unready_detail=$8
	shift 8

	if ! provider_available "$command_name"; then
		emit_capability "$section" "$id" "$label" unavailable "$class" "$command_name" "$missing_detail"
	elif run_bounded_probe "$command_name" "$@"; then
		emit_capability "$section" "$id" "$label" available "$class" "$command_name" "$available_detail"
	else
		emit_capability "$section" "$id" "$label" unavailable "$class" "$command_name" "$unready_detail"
	fi
}

trusted_health_helper() {
	path_candidate=$(command -v dwm-system-health 2>/dev/null || true)
	for candidate in "$path_candidate" /usr/local/bin/dwm-system-health /usr/bin/dwm-system-health; do
		[ -n "$candidate" ] || continue
		trusted_installed_file "$candidate" || continue
		return 0
	done
	return 1
}

trusted_parent_chain() {
	parent=${1%/*}
	while :; do
		[ -d "$parent" ] && [ ! -L "$parent" ] || return 1
		[ "$(stat -c %u -- "$parent" 2>/dev/null || printf 1)" = 0 ] || return 1
		find "$parent" -maxdepth 0 -type d ! -perm /022 -print -quit 2>/dev/null | grep -q . || return 1
		[ "$parent" = / ] && return 0
		parent=${parent%/*}
		[ -n "$parent" ] || parent=/
	done
}

trusted_installed_file() {
	candidate=$1
	canonical=$(readlink -f -- "$candidate" 2>/dev/null || true)
	[ -n "$canonical" ] && [ "$canonical" = "$candidate" ] || return 1
	trusted_parent_chain "$canonical" || return 1
	[ -f "$canonical" ] && [ ! -L "$canonical" ] && [ -x "$canonical" ] || return 1
	[ "$(stat -c %u -- "$canonical" 2>/dev/null || printf 1)" = 0 ] || return 1
	find "$canonical" -maxdepth 0 -type f ! -perm /022 -print -quit 2>/dev/null | grep -q .
}

trusted_display_helper() {
	display_command=$(command -v dwm-settings-display 2>/dev/null || true)
	display_helper=
	case $display_command in
	*/bin/dwm-settings-display)
		display_helper=${display_command%/bin/dwm-settings-display}/libexec/dwm-titus/dwm-settings-display-root
		;;
	esac
	for candidate in "$display_helper" /usr/local/libexec/dwm-titus/dwm-settings-display-root \
		/usr/libexec/dwm-titus/dwm-settings-display-root; do
		[ -n "$candidate" ] || continue
		trusted_installed_file "$candidate" || continue
		setup_candidate=${candidate%/libexec/dwm-titus/dwm-settings-display-root}/bin/dwm-display-setup
		trusted_installed_file "$setup_candidate" || continue
		return 0
	done
	return 1
}

discover() {
	os_release=${DWM_SETTINGS_OS_RELEASE:-/etc/os-release}
	platform_id=unknown
	platform_pretty='Unknown Linux'
	if [ -r "$os_release" ]; then
		platform_id=$(os_value ID "$os_release")
		platform_pretty=$(os_value PRETTY_NAME "$os_release")
		[ -n "$platform_id" ] || platform_id=unknown
		[ -n "$platform_pretty" ] || platform_pretty=$platform_id
	fi
	platform_family_name=$(platform_family "$platform_id")

	printf 'settings-protocol\t1\n'
	printf 'platform\t%s\t%s\t%s\n' \
		"$(clean_field "$platform_id")" \
		"$(clean_field "$platform_family_name")" \
		"$(clean_field "$platform_pretty")"

	emit_probed_command_capability displays randr 'Display discovery' read-only xrandr \
		'RandR display state is available' \
		'Install the X11 RandR tools and open Settings from X11' \
		'RandR tools are installed, but no responsive X11 display is available' \
		--query
	if provider_available dwm-settings-display; then
		emit_capability displays display-changes 'Display changes' available user-session \
			dwm-settings-display 'Validated layout previews, rollback, and user profiles are available'
	else
		emit_capability displays display-changes 'Display changes' unavailable user-session \
			dwm-settings-display 'Install the managed display Settings provider'
	fi
	if trusted_display_helper && provider_available pkexec; then
		emit_capability displays display-persistence 'Persistent display profiles' available privileged \
			dwm-settings-display-root 'Managed Xorg install and rollback are available through polkit'
	else
		emit_capability displays display-persistence 'Persistent display profiles' restricted privileged \
			dwm-settings-display-root 'Live previews remain available; install the trusted root helper for persistence'
	fi

	if ! provider_available dwm-settings-input || ! provider_available xinput; then
		input_discovery_state=missing
	elif input_snapshot_valid; then
		input_discovery_state=available
	else
		input_discovery_state=unready
	fi
	if [ "$input_discovery_state" = available ]; then
		emit_capability input input-devices 'Input devices' available user-session \
			dwm-settings-input 'Stable device discovery, preview, reset, and persistence are available'
	elif [ "$input_discovery_state" = unready ]; then
		emit_capability input input-devices 'Input devices' unavailable user-session \
			dwm-settings-input 'Input tools are installed, but no responsive XInput session is available'
	else
		emit_capability input input-devices 'Input devices' unavailable user-session \
			dwm-settings-input 'Install xinput and the managed input Settings provider'
	fi

	emit_probed_command_capability network networkmanager NetworkManager delegated nmcli \
		'NetworkManager state is available' \
		'Install NetworkManager to enable this section' \
		'NetworkManager is installed, but its service is not responding' \
		-t -f RUNNING general
	emit_probed_command_capability bluetooth bluez Bluetooth delegated bluetoothctl \
		'BlueZ state is available' \
		'Install BlueZ tools to enable this section' \
		'BlueZ tools are installed, but no daemon or adapter is responding' \
		show

	if run_bounded_probe pactl info; then
		emit_capability audio pipewire-audio Audio available user-session pactl \
			'PipeWire Pulse-compatible session controls are available'
	elif run_bounded_probe wpctl status; then
		emit_capability audio pipewire-audio Audio available user-session wpctl \
			'WirePlumber session controls are available'
	elif provider_available pactl || provider_available wpctl; then
		emit_capability audio pipewire-audio Audio unavailable user-session pipewire \
			'Audio tools are installed, but no PipeWire or Pulse session is responding'
	else
		emit_capability audio pipewire-audio Audio unavailable user-session pipewire \
			'Start PipeWire and install pactl or wpctl'
	fi

	emit_probed_command_capability power dpms 'Display power management' user-session xset \
		'X11 DPMS state is available' \
		'Install xset and open Settings from X11' \
		'xset is installed, but no responsive X11 display is available' \
		q
	if run_bounded_probe xset q && provider_available light-locker &&
		run_bounded_probe gsettings get apps.light-locker lock-after-screensaver; then
		emit_capability power auto-lock 'Automatic locking' available user-session light-locker \
			'Light-locker session policy is available'
	else
		emit_capability power auto-lock 'Automatic locking' partial user-session light-locker \
			'Install xset, GLib settings, and light-locker for full support'
	fi

	if run_bounded_probe xdg-settings get default-web-browser &&
		run_bounded_probe xdg-mime query default text/html; then
		emit_capability defaults xdg-defaults 'Default applications' available user-session xdg-utils \
			'Browser, terminal, file-manager, and MIME defaults are manageable'
	elif provider_available xdg-settings && provider_available xdg-mime; then
		emit_capability defaults xdg-defaults 'Default applications' unavailable user-session xdg-utils \
			'XDG tools are installed, but the current desktop defaults are not readable'
	else
		emit_capability defaults xdg-defaults 'Default applications' unavailable user-session xdg-utils \
			'Install xdg-utils to inspect desktop defaults'
	fi
	if ! provider_available dwm-xdg-autostart; then
		emit_capability defaults xdg-autostart 'Startup applications' unavailable user-session xdg-autostart \
			'Install the managed XDG autostart helper to inspect and change startup applications'
	elif provider_available inotifywait; then
		emit_capability defaults xdg-autostart 'Startup applications' available user-session xdg-autostart \
			'Per-user XDG autostart overrides and live updates are available'
	else
		emit_capability defaults xdg-autostart 'Startup applications' partial user-session xdg-autostart \
			'Autostart entries are readable; install inotify-tools for live updates'
	fi

	if ! provider_available dwm-settings-appearance; then
		emit_capability appearance themes Themes unavailable read-only dwm-settings-appearance \
			'Install the managed appearance provider'
	elif appearance_snapshot_valid; then
		if appearance_mutation_ready; then
			emit_capability appearance themes Themes available user-session dwm-settings-theme \
				'Theme inventory, bounded preview, apply, reset, and recovery are available'
		elif provider_available dwm-settings-theme; then
			emit_capability appearance themes Themes partial read-only dwm-settings-appearance \
				'Theme inventory is available; the theme source is not safely mutable'
		else
			emit_capability appearance themes Themes partial read-only dwm-settings-appearance \
				'Theme inventory is available; install the managed mutation helper for changes'
		fi
	else
		emit_capability appearance themes Themes unavailable read-only dwm-settings-appearance \
			'Restore a valid themes.toml configuration or inspect the appearance snapshot errors'
	fi
	emit_accessibility_capabilities

	if provider_available dwm-system-health; then
		emit_capability system health 'System health' available read-only dwm-system-health \
			'Unprivileged health state is available'
	else
		emit_capability system health 'System health' unavailable read-only dwm-system-health \
			'Install the dwm-system-health helper'
	fi
	if trusted_health_helper && {
		provider_available pkexec ||
			{ provider_available sudo && run_bounded_probe sudo -n -v; }
	}; then
		emit_capability system authorization 'Administrative authorization' available privileged polkit \
			'A trusted installed helper and authorization tool are available'
	else
		emit_capability system authorization 'Administrative authorization' restricted privileged polkit \
			'Read-only state remains available; install the trusted system helper for authorized actions'
	fi
	emit_capability system administration 'Advanced administration' unsupported delegated fedora-tools \
		'High-risk administration remains delegated to trusted tools'
}

case ${1:-} in
discover)
	[ "$#" -eq 1 ] || {
		usage
		exit 2
	}
	discover
	;;
-h | --help | help)
	usage
	;;
*)
	usage
	exit 2
	;;
esac
