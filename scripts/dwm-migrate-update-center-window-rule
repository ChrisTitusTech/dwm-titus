#!/usr/bin/python3

import os
import re
import shutil
import stat
import sys
import tempfile
import tomllib
from pathlib import Path


RULE = {
    "title": "dwm update center",
    "class": "DwmUpdateCenter",
    "instance": "dwm-update-center",
    "isfloating": 1,
    "noswallow": 1,
}
RULE_TEXT = (
    '  { title="dwm update center", class="DwmUpdateCenter", '
    'instance="dwm-update-center", isfloating=1, noswallow=1 },\n'
)


def rules_array_end(text):
    match = re.search(r"(?m)^[ \t]*rules[ \t]*=[ \t]*\[", text)
    if not match:
        raise ValueError("missing top-level rules array")

    depth = 1
    quote = None
    escaped = False
    comment = False
    last_significant = None
    for index in range(match.end(), len(text)):
        char = text[index]
        if comment:
            if char == "\n":
                comment = False
            continue
        if quote:
            if quote == '"' and escaped:
                escaped = False
            elif quote == '"' and char == "\\":
                escaped = True
            elif char == quote:
                quote = None
            continue
        if char == "#":
            comment = True
        elif char in "\"'":
            quote = char
        elif char == "[":
            depth += 1
            last_significant = char
        elif char == "]":
            depth -= 1
            if depth == 0:
                needs_comma = last_significant is not None and last_significant not in {"[", ","}
                return index, needs_comma
            last_significant = char
        elif not char.isspace():
            last_significant = char
    raise ValueError("unterminated rules array")


def migrate(path):
    if path.is_symlink():
        raise ValueError("refusing to replace a symlink")
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(descriptor, "rb") as source:
        info = os.fstat(source.fileno())
        if not stat.S_ISREG(info.st_mode):
            raise ValueError("window rules must be a regular file")
        data = source.read(4 * 1024 * 1024 + 1)
    if len(data) > 4 * 1024 * 1024:
        raise ValueError("window rules exceed the 4 MiB migration limit")
    original = data.decode("utf-8")
    try:
        document = tomllib.loads(original)
    except tomllib.TOMLDecodeError as error:
        raise ValueError(f"invalid TOML: {error}") from error

    rules = document.get("rules")
    if not isinstance(rules, list):
        raise ValueError("missing top-level rules array")
    if any(all(rule.get(key) == value for key, value in RULE.items())
           for rule in rules if isinstance(rule, dict)):
        return False

    end, needs_comma = rules_array_end(original)
    prefix = original[:end]
    if needs_comma:
        last_line = prefix.rstrip("\r\n").split("\n")[-1]
        if "#" in last_line:
            prefix = prefix.rstrip("\r\n") + "\n,\n"
        else:
            prefix = prefix.rstrip("\r\n") + ",\n"
    elif prefix and not prefix.endswith("\n"):
        prefix += "\n"
    migrated = prefix + RULE_TEXT + original[end:]
    try:
        tomllib.loads(migrated)
    except tomllib.TOMLDecodeError as error:
        raise ValueError(f"generated invalid TOML: {error}") from error

    mode = path.stat().st_mode & 0o777
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w") as output:
            output.write(migrated)
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, mode)
        # Keep a unique recovery copy even for direct source-installer migrations.
        backup_fd, backup = tempfile.mkstemp(prefix=f"{path.name}.before-update-center.", dir=path.parent)
        os.close(backup_fd)
        shutil.copy2(path, backup)
        with open(backup, "rb") as saved:
            os.fsync(saved.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    return True


def main():
    if len(sys.argv) > 2:
        print(f"usage: {Path(sys.argv[0]).name} [window-rules.toml]", file=sys.stderr)
        return 2
    if len(sys.argv) == 2:
        path = Path(sys.argv[1])
    else:
        configured = os.environ.get("XDG_CONFIG_HOME", "")
        config_home = Path(configured) if os.path.isabs(configured) else Path.home() / ".config"
        path = config_home / "dwm-titus" / "window-rules.toml"
    if not path.exists():
        return 0
    try:
        changed = migrate(path)
    except (OSError, ValueError) as error:
        print(f"dwm-migrate-update-center-window-rule: {error}", file=sys.stderr)
        return 1
    if changed:
        print(f"dwm-titus: added Update Center window rule to {path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
