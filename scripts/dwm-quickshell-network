#!/bin/sh
set -eu

usage() {
	printf '%s\n' "usage: dwm-quickshell-network status|devices|connections|wifi-scan [--rescan yes|no] [ifname]|wifi-connect <ifname> <bssid> <ssid> [--password-stdin <security>]|connect <uuid>|disconnect <device>|monitor|editor" >&2
	exit 2
}

need_nmcli() {
	if ! command -v nmcli >/dev/null 2>&1; then
		printf '%s\n' "nmcli not found" >&2
		exit 127
	fi
}

nmcli_tab() {
	nmcli --terse --escape yes "$@" |
		awk '
			{
				field = ""
				output = ""
				count = 0
				escaped = 0
				for (i = 1; i <= length($0); i++) {
					char = substr($0, i, 1)
					if (escaped) {
						field = field char
						escaped = 0
					} else if (char == "\\") {
						escaped = 1
					} else if (char == ":") {
						output = output (count == 0 ? "" : "\t") field
						count++
						field = ""
					} else {
						field = field char
					}
				}
				print output (count == 0 ? "" : "\t") field
			}
		'
}

status() {
	need_nmcli

	nmcli_tab -f DEVICE,TYPE,STATE device status 2>/dev/null |
		awk -F '\t' '
			$2 != "loopback" && $3 == "connected" {
				print "NET " $1
				found = 1
				exit
			}
			END {
				if (!found) {
					print "NET offline"
				}
			}
		'
}

devices() {
	need_nmcli
	nmcli_tab -f DEVICE,TYPE,STATE,CONNECTION device status |
		awk -F '\t' '$2 != "loopback"'
}

connections() {
	need_nmcli

	active=$(mktemp "${TMPDIR:-/tmp}/dwm-network-active.XXXXXX")
	trap 'rm -f "$active"' EXIT

	nmcli_tab -f NAME,UUID,TYPE,DEVICE connection show --active >"$active"
	nmcli_tab -f NAME,UUID,TYPE connection show |
		awk -F '\t' -v OFS='\t' '
			NR == FNR {
				active[$2] = 1
				device[$2] = $4
				next
			}
			$3 != "loopback" {
				print $1, $2, $3, (active[$2] ? "yes" : "no"), device[$2]
			}
		' "$active" -
}

wifi_scan() {
	need_nmcli

	rescan=no
	ifname=

	while [ "$#" -gt 0 ]; do
		case "$1" in
		--rescan)
			[ "$#" -ge 2 ] || usage
			case "$2" in
			yes | no | auto)
				rescan=$2
				;;
			*)
				usage
				;;
			esac
			shift 2
			;;
		*)
			[ -z "$ifname" ] || usage
			ifname=$1
			shift
			;;
		esac
	done

	if [ -n "$ifname" ]; then
		nmcli_tab -f IN-USE,BSSID,SSID,SIGNAL,SECURITY,CHAN,DEVICE device wifi list ifname "$ifname" --rescan "$rescan"
	else
		nmcli_tab -f IN-USE,BSSID,SSID,SIGNAL,SECURITY,CHAN,DEVICE device wifi list --rescan "$rescan"
	fi
}

wifi_connect() {
	need_nmcli
	if [ "$#" -ne 3 ] && [ "$#" -ne 5 ]; then
		usage
	fi

	ifname=$1
	bssid=$2
	ssid=$3

	if [ -z "$ifname" ] || [ -z "$bssid" ] || [ -z "$ssid" ]; then
		usage
	fi

	if [ "$#" -eq 5 ]; then
		[ "$4" = "--password-stdin" ] || usage
		security=$5
		key_mgmt=wpa-psk
		secret_property=802-11-wireless-security.psk
		wep_key_type=
		case "$security" in
		*WEP*)
			key_mgmt=none
			secret_property=802-11-wireless-security.wep-key0
			;;
		*WPA3*)
			case "$security" in
			*WPA2*) ;;
			*) key_mgmt=sae ;;
			esac
			;;
		esac

		umask 077
		password_file=$(mktemp "${TMPDIR:-/tmp}/dwm-network-password.XXXXXX")
		connection_uuid=
		trap 'rm -f "$password_file"' EXIT
		trap 'rm -f "$password_file"; if [ -n "$connection_uuid" ]; then nmcli connection delete uuid "$connection_uuid" >/dev/null 2>&1 || :; fi; exit 1' HUP INT TERM

		if ! IFS= read -r password || [ -z "$password" ]; then
			printf '%s\n' "Wi-Fi password required on stdin" >&2
			exit 2
		fi
		if [ "$key_mgmt" = "none" ]; then
			wep_key_type=passphrase
			case ${#password} in
			5 | 13)
				wep_key_type=key
				;;
			10 | 26)
				case "$password" in
				*[!0123456789abcdefABCDEF]*) ;;
				*) wep_key_type=key ;;
				esac
				;;
			esac
		fi
		printf '%s:%s\n' "$secret_property" "$password" >"$password_file"
		unset password

		IFS= read -r connection_uuid </proc/sys/kernel/random/uuid
		if [ -z "$connection_uuid" ]; then
			printf '%s\n' "could not generate a connection UUID" >&2
			exit 1
		fi

		set -- connection add type wifi ifname "$ifname" con-name "$ssid" ssid "$ssid" \
			802-11-wireless.bssid "$bssid" wifi-sec.key-mgmt "$key_mgmt"
		if [ -n "$wep_key_type" ]; then
			set -- "$@" wifi-sec.wep-key-type "$wep_key_type"
		fi
		set -- "$@" connection.uuid "$connection_uuid"
		nmcli "$@" >/dev/null

		if nmcli connection up uuid "$connection_uuid" ifname "$ifname" ap "$bssid" \
			passwd-file "$password_file"; then
			trap - HUP INT TERM
			connection_uuid=
			return 0
		else
			status=$?
		fi

		nmcli connection delete uuid "$connection_uuid" >/dev/null 2>&1 || :
		connection_uuid=
		return "$status"
	else
		nmcli device wifi connect "$ssid" ifname "$ifname" bssid "$bssid"
	fi
}

connect_uuid() {
	need_nmcli
	[ "$#" -eq 1 ] || usage
	nmcli connection up uuid "$1"
}

disconnect_device() {
	need_nmcli
	[ "$#" -eq 1 ] || usage
	nmcli device disconnect "$1"
}

monitor() {
	need_nmcli

	nmcli monitor |
		while IFS= read -r _event; do
			printf '%s\n' changed
		done
}

editor() {
	if ! command -v nm-connection-editor >/dev/null 2>&1; then
		printf '%s\n' "nm-connection-editor not found" >&2
		exit 127
	fi

	exec nm-connection-editor
}

[ "$#" -ge 1 ] || usage

command=$1
shift

case "$command" in
status)
	[ "$#" -eq 0 ] || usage
	status
	;;
devices)
	[ "$#" -eq 0 ] || usage
	devices
	;;
connections)
	[ "$#" -eq 0 ] || usage
	connections
	;;
wifi-scan)
	wifi_scan "$@"
	;;
wifi-connect)
	wifi_connect "$@"
	;;
connect)
	connect_uuid "$@"
	;;
disconnect)
	disconnect_device "$@"
	;;
monitor)
	[ "$#" -eq 0 ] || usage
	monitor
	;;
editor)
	[ "$#" -eq 0 ] || usage
	editor
	;;
*)
	usage
	;;
esac
