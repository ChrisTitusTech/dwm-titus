#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

config_home=${XDG_CONFIG_HOME:-}
[[ $config_home == /* ]] || config_home=${HOME:?HOME is required for XDG_CONFIG_HOME fallback}/.config
config_file=$config_home/dwm-titus/xsettingsd.conf
runtime_base=${XDG_RUNTIME_DIR:-}
if [[ -z $runtime_base ]]; then
	runtime_base=/tmp/dwm-titus-$UID
elif [[ $runtime_base != /* ]]; then
	printf 'dwm-xsettings: XDG_RUNTIME_DIR must be an absolute path\n' >&2
	exit 1
fi
lock_file=$runtime_base/dwm-xsettings.lock
reload_log=$runtime_base/dwm-xsettings.reload.log
readonly max_config_size=65536
readonly activation_timeout_seconds=3

usage() {
	printf 'usage: %s session-apply|reload|status|watch\n' "${0##*/}" >&2
}

die() {
	printf 'dwm-xsettings: %s\n' "$*" >&2
	exit 1
}

ensure_runtime() {
	if [[ ! -e $runtime_base ]]; then
		(umask 077 && mkdir -p -- "$runtime_base")
	fi
	[[ -d $runtime_base && ! -L $runtime_base &&
		$(stat -c %u -- "$runtime_base") == "$UID" ]] ||
		die "unsafe runtime directory: $runtime_base"
	chmod 700 -- "$runtime_base"
	if [[ -e $lock_file ]]; then
		[[ -f $lock_file && ! -L $lock_file &&
			$(stat -c %u -- "$lock_file") == "$UID" ]] ||
			die "unsafe lock file: $lock_file"
	fi
	: >>"$lock_file"
	chmod 600 -- "$lock_file"
	if [[ -e $reload_log ]]; then
		[[ -f $reload_log && ! -L $reload_log &&
			$(stat -c %u -- "$reload_log") == "$UID" &&
			$(stat -c %h -- "$reload_log") == 1 ]] ||
			die "unsafe reload log: $reload_log"
	fi
	: >>"$reload_log"
	chmod 600 -- "$reload_log"
	exec 9>"$lock_file"
	flock 9
}

load_config() {
	local line first=true seen_dpi=false
	xsettings_dpi=
	[[ ! -e $config_file && ! -L $config_file ]] && return 0
	[[ -f $config_file && ! -L $config_file && -r $config_file &&
		$(stat -c %u -- "$config_file") == "$UID" &&
		$(stat -c %h -- "$config_file") == 1 &&
		$(stat -c %s -- "$config_file") -le $max_config_size ]] ||
		die "unsafe generated configuration: $config_file"
	while IFS= read -r line || [[ -n $line ]]; do
		if [[ $first == true ]]; then
			[[ $line == '# Auto-generated by theme-apply.sh - do not edit manually.' ]] ||
				die "invalid generated configuration: $config_file"
			first=false
			continue
		fi
		case $line in
		'' | '# '*) ;;
		Xft/DPI\ *)
			[[ $seen_dpi == false ]] || die "duplicate Xft/DPI setting: $config_file"
			xsettings_dpi=${line#Xft/DPI }
			[[ $xsettings_dpi =~ ^[1-9][0-9]{4,6}$ ]] ||
				die "invalid Xft/DPI setting: $config_file"
			seen_dpi=true
			;;
		*)
			[[ ${#line} -le 4095 && $line != *$'\t'* && $line != *$'\r'* ]] ||
				die "unsafe generated setting: $config_file"
			;;
		esac
	done <"$config_file"
	[[ $first == false ]] || die "empty generated configuration: $config_file"
}

process_starttime() {
	local pid=$1
	awk '
		{
			line = $0
			sub(/^.*\) /, "", line)
			split(line, fields, " ")
			if (fields[1] != "Z" && fields[20] ~ /^[0-9]+$/) print fields[20]
		}
	' "/proc/$pid/stat" 2>/dev/null
}

canonical_display() {
	local display=$1 prefix remainder display_number screen_number=0
	[[ -n $display && ${#display} -le 255 && $display != *[[:space:]]* ]] || return 1
	case $display in
	:*)
		prefix=local
		remainder=${display#:}
		;;
	unix:*)
		prefix=local
		remainder=${display#unix:}
		;;
	unix/:*)
		prefix=local
		remainder=${display#unix/:}
		;;
	*:*)
		prefix=${display%:*}
		remainder=${display##*:}
		[[ -n $prefix ]] || return 1
		;;
	*) return 1 ;;
	esac
	if [[ $remainder == *.* ]]; then
		display_number=${remainder%%.*}
		screen_number=${remainder#*.}
	else
		display_number=$remainder
	fi
	[[ $display_number =~ ^[0-9]{1,9}$ && $screen_number =~ ^[0-9]{1,9}$ ]] || return 1
	printf '%s:%d.%d\n' "$prefix" "$((10#$display_number))" "$((10#$screen_number))"
}

process_matches() {
	local pid=$1 starttime=${2:-} process_display process_display_id current_display_id executable
	local -a arguments=()
	[[ $(stat -c %u -- "/proc/$pid" 2>/dev/null) == "$UID" ]] || return 1
	[[ -z $starttime || $(process_starttime "$pid") == "$starttime" ]] || return 1
	executable=$(readlink -f -- "/proc/$pid/exe" 2>/dev/null) || return 1
	case ${executable##*/} in
	xsettingsd | 'xsettingsd (deleted)') ;;
	*) return 1 ;;
	esac
	process_display=$({
		tr '\0' '\n' <"/proc/$pid/environ"
	} 2>/dev/null | awk -F= '
		$1 == "DISPLAY" { value = substr($0, 9); count++ }
		END { if (count == 1) print value; exit(count == 1 ? 0 : 1) }
	') || return 1
	process_display_id=$(canonical_display "$process_display") || return 1
	current_display_id=$(canonical_display "${DISPLAY:-}") || return 1
	[[ $process_display_id == "$current_display_id" ]] || return 1
	mapfile -d '' -t arguments <"/proc/$pid/cmdline" 2>/dev/null || return 1
	case ${#arguments[@]} in
	3) [[ ${arguments[1]} == -c || ${arguments[1]} == --config ]] &&
		[[ ${arguments[2]} == "$config_file" ]] ;;
	2) [[ ${arguments[1]} == "--config=$config_file" ]] ;;
	*) return 1 ;;
	esac
}

matching_identities() {
	local pid starttime
	command -v pgrep >/dev/null 2>&1 || die 'pgrep is unavailable for XSETTINGS process discovery'
	while IFS= read -r pid; do
		[[ $pid =~ ^[1-9][0-9]*$ ]] || continue
		process_matches "$pid" || continue
		starttime=$(process_starttime "$pid") || continue
		[[ -n $starttime ]] && printf '%s:%s\n' "$pid" "$starttime"
	done < <(pgrep -x xsettingsd 2>/dev/null || true)
}

identity_matches() {
	local identity=$1 pid starttime
	pid=${identity%%:*}
	starttime=${identity#*:}
	process_matches "$pid" "$starttime"
}

published_dpi() {
	command -v dump_xsettings >/dev/null 2>&1 || return 1
	timeout --signal=TERM --kill-after=1 0.2 dump_xsettings 2>/dev/null |
		awk '
			$1 == "Xft/DPI" && $2 ~ /^[1-9][0-9]{4,6}$/ && NF == 2 {
				value = $2
				count++
			}
			END {
				if (count == 1) print value
				exit(count == 1 ? 0 : 1)
			}
		'
}

xsettings_owner_present() {
	command -v dump_xsettings >/dev/null 2>&1 || return 1
	timeout --signal=TERM --kill-after=1 3 dump_xsettings >/dev/null 2>&1
}

wait_for_active() {
	local expected=$1 identities=${2:-} published deadline
	deadline=$((SECONDS + activation_timeout_seconds))
	while ((SECONDS < deadline)); do
		[[ -n $identities ]] || identities=$(matching_identities)
		if [[ -n $identities ]]; then
			while IFS= read -r identity; do
				if [[ -z $identity ]] || ! identity_matches "$identity"; then
					continue
				fi
				published=$(published_dpi 2>/dev/null || true)
				[[ $published == "$expected" ]] && return 0
			done <<<"$identities"
		fi
		sleep 0.05
	done
	return 1
}

wait_for_reload_ack() {
	local identities=$1 identity line deadline
	deadline=$((SECONDS + activation_timeout_seconds))
	while ((SECONDS < deadline)); do
		while IFS= read -r line; do
			case $line in
			"xsettingsd: Loaded "*" from $config_file") return 0 ;;
			"xsettingsd: Unable to parse $config_file: "*) return 1 ;;
			esac
		done <"$reload_log"
		while IFS= read -r identity; do
			[[ -z $identity ]] || identity_matches "$identity" || return 1
		done <<<"$identities"
		sleep 0.05
	done
	return 1
}

start_or_reload() {
	local identities identity pid
	command -v xsettingsd >/dev/null 2>&1 ||
		die 'xsettingsd is unavailable for managed X11 text scaling'
	command -v dump_xsettings >/dev/null 2>&1 ||
		die 'dump_xsettings is unavailable for managed X11 text scaling verification'
	identities=$(matching_identities)
	if [[ -n $identities ]]; then
		: >"$reload_log"
		while IFS= read -r identity; do
			[[ -n $identity ]] || continue
			pid=${identity%%:*}
			identity_matches "$identity" && kill -HUP "$pid" 2>/dev/null || true
		done <<<"$identities"
	else
		if xsettings_owner_present; then
			die 'another XSETTINGS manager already owns this display'
		fi
		if command -v setsid >/dev/null 2>&1; then
			setsid -f xsettingsd --config "$config_file" 8>&- 9>&- \
				>/dev/null 2>>"$reload_log"
		else
			xsettingsd --config "$config_file" 8>&- 9>&- </dev/null \
				>/dev/null 2>>"$reload_log" &
		fi
	fi
	if [[ -n $identities ]]; then
		wait_for_reload_ack "$identities" ||
			die 'xsettingsd rejected the requested configuration reload'
	fi
	wait_for_active "$xsettings_dpi" "$identities" ||
		die 'xsettingsd did not publish the requested X11 text scale'
}

stop_managed() {
	local identities identity pid attempt live
	identities=$(matching_identities)
	[[ -n $identities ]] || return 0
	while IFS= read -r identity; do
		[[ -n $identity ]] || continue
		pid=${identity%%:*}
		identity_matches "$identity" && kill -TERM "$pid" 2>/dev/null || true
	done <<<"$identities"
	for ((attempt = 0; attempt < 40; attempt++)); do
		live=false
		while IFS= read -r identity; do
			[[ -n $identity ]] || continue
			if identity_matches "$identity"; then
				live=true
				break
			fi
		done <<<"$identities"
		[[ $live == false ]] && return 0
		sleep 0.05
	done
	while IFS= read -r identity; do
		[[ -n $identity ]] || continue
		pid=${identity%%:*}
		identity_matches "$identity" && kill -KILL "$pid" 2>/dev/null || true
	done <<<"$identities"
}

apply_session_state() {
	ensure_runtime
	load_config
	if [[ -n $xsettings_dpi ]]; then
		[[ -n ${DISPLAY:-} ]] || die 'DISPLAY is required for managed X11 text scaling'
		start_or_reload
		printf 'xsettings-protocol\t1\t0\nresult\tactive\t%s\n' "$xsettings_dpi"
	else
		[[ -n ${DISPLAY:-} ]] || die 'DISPLAY is required to restore system X11 text scaling'
		stop_managed
		printf 'xsettings-protocol\t1\t0\nresult\tsystem-follow\n'
	fi
}

status() {
	local identities published
	load_config
	printf 'xsettings-protocol\t1\t0\n'
	if [[ -n $xsettings_dpi ]]; then
		if ! command -v xsettingsd >/dev/null 2>&1 ||
			! command -v dump_xsettings >/dev/null 2>&1; then
			printf 'state\tunavailable\t%s\n' "$xsettings_dpi"
		else
			identities=$(matching_identities)
			if [[ -n $identities && $(published_dpi 2>/dev/null || true) == "$xsettings_dpi" ]]; then
				printf 'state\tactive\t%s\n' "$xsettings_dpi"
			else
				printf 'state\tinactive\t%s\n' "$xsettings_dpi"
			fi
		fi
	else
		identities=$(matching_identities)
		if [[ -n $identities ]]; then
			published=$(published_dpi 2>/dev/null || printf unknown)
			printf 'state\tstale\t%s\n' "$published"
		else
			printf 'state\tsystem-follow\n'
		fi
	fi
}

watch_owner() {
	local identities identity pid pid_list='' wait_pid='' wait_status=0
	command -v pidwait >/dev/null 2>&1 || die 'pidwait is unavailable for XSETTINGS lifecycle watching'
	[[ -n ${DISPLAY:-} ]] || die 'DISPLAY is required for XSETTINGS lifecycle watching'
	load_config
	identities=$(matching_identities)
	[[ -n $identities ]] || die 'managed xsettingsd is not active'
	while IFS= read -r identity; do
		[[ -n $identity ]] || continue
		identity_matches "$identity" || continue
		pid=${identity%%:*}
		[[ -z $pid_list ]] || pid_list+=,
		pid_list+=$pid
	done <<<"$identities"
	[[ -n $pid_list ]] || die 'managed xsettingsd changed before lifecycle watching started'
	# pidwait blocks on Linux pidfds. xsettingsd exits when its XSETTINGS
	# selection is replaced, so process lifecycle covers both owner loss and an
	# ordinary daemon exit without polling the status helper.
	pidwait -p "$pid_list" >/dev/null 2>&1 &
	wait_pid=$!
	if [[ -n ${DWM_TEST_XSETTINGS_WATCH_READY:-} ]]; then
		: >"$DWM_TEST_XSETTINGS_WATCH_READY"
	fi
	trap 'kill -TERM "$wait_pid" 2>/dev/null || true; wait "$wait_pid" 2>/dev/null || true; exit 129' HUP
	trap 'kill -TERM "$wait_pid" 2>/dev/null || true; wait "$wait_pid" 2>/dev/null || true; exit 130' INT
	trap 'kill -TERM "$wait_pid" 2>/dev/null || true; wait "$wait_pid" 2>/dev/null || true; exit 143' TERM
	wait "$wait_pid" || wait_status=$?
	wait_pid=
	trap - HUP INT TERM
	if ((wait_status != 0)); then
		while IFS= read -r identity; do
			[[ -z $identity ]] || ! identity_matches "$identity" ||
				die 'pidwait failed while the managed xsettingsd was still active'
		done <<<"$identities"
	fi
	printf 'xsettings-event-protocol\t1\t0\nchanged\n'
}

case ${1:-} in
session-apply | reload)
	[[ $# -eq 1 ]] || {
		usage
		exit 2
	}
	apply_session_state
	;;
status)
	[[ $# -eq 1 ]] || {
		usage
		exit 2
	}
	status
	;;
watch)
	[[ $# -eq 1 ]] || {
		usage
		exit 2
	}
	watch_owner
	;;
-h | --help | help)
	usage
	;;
*)
	usage
	exit 2
	;;
esac
