#!/usr/bin/env bash
set -euo pipefail

fedora_release=${DWM_TEST_FEDORA_RELEASE:-45}
case "$fedora_release" in
44 | 45) ;;
*)
	printf 'Supported test releases are Fedora 44 and 45\n' >&2
	exit 2
	;;
esac

# All host Git operations are read-only, including optional index refreshes.
export GIT_OPTIONAL_LOCKS=0
for dependency in podman git tar findmnt; do
	command -v "$dependency" >/dev/null 2>&1 || {
		printf 'Required command is unavailable: %s\n' "$dependency" >&2
		exit 2
	}
done
if ! rootless=$(podman info --format '{{.Host.Security.Rootless}}'); then
	printf 'Could not query Podman rootless state\n' >&2
	exit 2
fi
if [[ $rootless != true ]]; then
	printf 'Rootless Podman is required\n' >&2
	exit 2
fi
source_tree=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
repository=$(git -C "$source_tree" rev-parse --path-format=absolute --git-common-dir)
head=$(git -C "$source_tree" rev-parse --verify HEAD)
# Podman's comma-delimited --mount grammar cannot represent commas in paths.
if [[ $source_tree == *,* || $repository == *,* ]]; then
	printf 'Podman source mount paths must not contain commas\n' >&2
	exit 2
fi
reject_nested_mounts() {
	local mounts encoded target
	if ! mounts=$(findmnt --raw --noheadings --output TARGET) || [[ -z $mounts ]]; then
		printf 'Could not inspect host mounts\n' >&2
		exit 2
	fi
	while IFS= read -r encoded; do
		# findmnt raw output hex-escapes whitespace and backslashes.
		printf -v target '%b' "$encoded"
		if [[ $target != /* ]]; then
			printf 'Could not inspect host mounts: invalid target\n' >&2
			exit 2
		fi
		if [[ $target == "$source_tree/"* || $target == "$repository/"* ]]; then
			printf 'Nested host mounts are unsupported: %s\n' "$target" >&2
			exit 2
		fi
	done <<<"$mounts"
}
# Reject every descendant mount, even ignored scratch; nonrecursive binds
# prevent any later child mount from becoming a writable path in the container.
reject_nested_mounts
image=localhost/dwm-titus-tests:fedora-$fedora_release
containerfile=tests/containers/fedora-$fedora_release/Containerfile
printf '==> Building Fedora %s test image\n' "$fedora_release"
set +e
tar -C "$source_tree" -cf - scripts/dwm-packages.sh "$containerfile" |
	podman build --tag "$image" --file "$containerfile" -
build_status=("${PIPESTATUS[@]}")
set -e
if ((build_status[1] != 0 || build_status[0] != 0)); then
	printf 'Fedora %s image build failed (context %s, build %s)\n' "$fedora_release" "${build_status[@]}" >&2
	((build_status[1] == 0)) || exit "${build_status[1]}"
	exit "${build_status[0]}"
fi
reject_nested_mounts

# The manifest uses the linked worktree's index and ignore rules. NUL framing
# preserves whitespace/newlines; tracked deleted paths are skipped in staging.
# No writable host mounts, host session sockets, or SELinux source relabeling.
printf '==> Staging current worktree in a disposable container\n'
set +e
git -C "$source_tree" ls-files -z --cached --others --exclude-standard |
	podman run --rm --interactive --network=private --security-opt=label=disable "--security-opt=unmask=/proc/*" \
		--mount "type=bind,src=$repository,dst=/source/repository,ro=true,bind-nonrecursive" \
		--mount "type=bind,src=$source_tree,dst=/source/worktree,ro=true,bind-nonrecursive" \
		"$image" bash -c '
set -euo pipefail
trap '\''printf "Container staging failed (status %s)\n" "$?" >&2'\'' ERR
mkdir -p /workspace
cd /workspace
manifest=$(mktemp /workspace/source.XXXXXX)
cat >"$manifest"
git clone --no-local --no-checkout /source/repository /workspace/checkout
cd /workspace/checkout
# A detached linked-worktree HEAD need not be advertised by the common repo.
# Read its complete reachable history without creating a host ref or object.
printf "%s\n" "$1" | git --git-dir=/source/repository pack-objects --revs --stdout |
    git index-pack --stdin
git checkout --detach "$1"
shift
git ls-files -z | xargs -0 -r rm -f --
available=$(mktemp /workspace/available.XXXXXX)
while IFS= read -r -d "" path; do
    case "$path" in .git|.git/*) continue ;; esac
    if [[ -e "/source/worktree/$path" || -L "/source/worktree/$path" ]]; then
        printf "%s\0" "$path" >>"$available"
    fi
done <"$manifest"
tar -C "/source/worktree" --no-recursion --null -T "$available" -cf - | tar -xf -
# Record deletions, then force only the already filtered literal source paths.
git add --update
git --literal-pathspecs add --force --pathspec-from-file="$available" --pathspec-file-nul
git -c user.name="Disposable test runner" -c user.email=tests@example.invalid \
    -c commit.gpgsign=false commit --allow-empty -m "Disposable test snapshot"
trap - ERR
# Desktop updater tests require a real unprivileged desktop UID. The image
# build/staging remains root only inside the rootless container.
test_command=(scripts/run-tests)
if ((EUID == 0)); then
    useradd --create-home --uid 1000 dwm-test
    chown -hR dwm-test:dwm-test /workspace
    test_command=(runuser -u dwm-test -- scripts/run-tests)
    # Preserve native tests that categorically reject display :0. A private
    # placeholder keeps Xvfb -displayfd on higher numbers in an empty container.
    Xvfb :0 -screen 0 1x1x24 -nolisten tcp -extension GLX >/workspace/reserved-x11.log 2>&1 &
    display_reservation=$!
    trap "kill $display_reservation 2>/dev/null || true" EXIT
    for attempt in {1..40}; do
        [[ ! -S /tmp/.X11-unix/X0 ]] || break
        kill -0 "$display_reservation" || { cat /workspace/reserved-x11.log >&2; exit 1; }
        sleep 0.05
    done
    [[ -S /tmp/.X11-unix/X0 ]] || { cat /workspace/reserved-x11.log >&2; exit 1; }
fi
printf "==> Running scripts/run-tests in Fedora\n"
if "${test_command[@]}" "$@"; then
    exit 0
else
    status=$?
    printf "Container test command failed (status %s)\n" "$status" >&2
    exit "$status"
fi
' container-stage "$head" "$@"
run_status=("${PIPESTATUS[@]}")
set -e
if ((run_status[1] != 0)); then
	printf 'Fedora %s container failed (status %s); see staging/test diagnostics above\n' "$fedora_release" "${run_status[1]}" >&2
	exit "${run_status[1]}"
fi
if ((run_status[0] != 0)); then
	printf 'Current worktree manifest failed (status %s)\n' "${run_status[0]}" >&2
	exit "${run_status[0]}"
fi
