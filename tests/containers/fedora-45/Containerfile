FROM registry.fedoraproject.org/fedora:45

COPY scripts/dwm-packages.sh /tmp/dwm-packages.sh
# Capabilities stay in the product package map. Extra utilities serve existing
# automated gates: lint, Git staging, ISO fixtures, GTK/Pillow, and Kickstarts.
# Fedora 45 has no shfmt RPM; pin the same formatter used on Fedora 44.
RUN bash -euo pipefail -c 'source /tmp/dwm-packages.sh; \
    packages=$(for profile in ci-smoke required wifi terminal desktop system-management qml-validation; do \
        dwm_packages fedora "$profile"; done); \
    mapfile -t packages < <(printf "%s\n" "$packages" | sort -u); \
    dnf install -y --setopt=install_weak_deps=False "${packages[@]}" \
        bash git-core tar findutils diffutils ShellCheck golang-bin \
        rsync pykickstart python3-pillow gtk3 gtk4 xorg-x11-xauth sudo; \
    GOBIN=/usr/local/bin CGO_ENABLED=0 GOSUMDB=sum.golang.org \
        go install -ldflags="-X main.version=v3.7.0" mvdan.cc/sh/v3/cmd/shfmt@v3.7.0; \
    test "$(shfmt --version)" = v3.7.0; \
    dnf clean all; rm /tmp/dwm-packages.sh'

# No systemd, host session, or hardware is required by the runner.
ENV QT_QUICK_BACKEND=software
